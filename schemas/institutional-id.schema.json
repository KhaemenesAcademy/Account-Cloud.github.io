{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/v2/institutional-id.schema.json",
  "title": "Khaemenes Institutional ID Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "institutionalId",
    "learnerId",
    "kind",
    "status",
    "recordVersion",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "institutionalId": {
      "type": "string",
      "pattern": "^(KA|KS)-\\d{4}-(?:[A-F0-9]{10}|[A-F0-9]{20})$"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^learner_"
    },
    "kind": {
      "enum": [
        "student",
        "scholar"
      ]
    },
    "status": {
      "enum": [
        "provisional",
        "confirmed",
        "migrated",
        "retired"
      ]
    },
    "previousInstitutionalId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
