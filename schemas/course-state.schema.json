{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/v2/course-state.schema.json",
  "title": "Course State Authority Mirror",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseStateId",
    "learnerId",
    "courseId",
    "status",
    "masteryPercent",
    "authority",
    "recordVersion",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "courseStateId": {
      "type": "string",
      "pattern": "^course_state_"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^learner_"
    },
    "courseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "not-started",
        "active",
        "review",
        "complete"
      ]
    },
    "masteryPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Mirror only; browser/Account Cloud generic sync cannot manufacture mastery."
    },
    "authority": {
      "const": "course-engine"
    },
    "sourceEvidenceVersion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
