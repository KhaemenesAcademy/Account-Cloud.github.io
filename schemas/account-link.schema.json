{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/v2/account-link.schema.json",
  "title": "Protected Account Subject Link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "linkId",
    "subjectType",
    "subjectId",
    "authSubjectRef",
    "status",
    "recordVersion",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "linkId": {
      "type": "string",
      "pattern": "^acctlink_"
    },
    "subjectType": {
      "enum": [
        "adult",
        "learner"
      ]
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "authSubjectRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "legacyLocalAccountId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Migration evidence only; never a secret."
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "pending"
      ]
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
