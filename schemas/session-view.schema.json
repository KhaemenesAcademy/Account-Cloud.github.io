{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/session-view.schema.json",
  "title": "Display-Safe Session View",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authenticated"
  ],
  "properties": {
    "authenticated": {
      "type": "boolean"
    },
    "adultId": {
      "type": [
        "string",
        "null"
      ]
    },
    "familyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fam_"
      }
    },
    "learnerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^learner_"
      }
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "authority": {
      "type": "string",
      "maxLength": 80
    }
  }
}
