{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/v2/sync-envelope.schema.json",
  "title": "Account Cloud Bounded Sync Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "resourceType",
    "resourceId",
    "baseVersion",
    "clientMutationId",
    "sourceDeviceId",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "operation": {
      "type": "string"
    },
    "resourceType": {
      "enum": [
        "family",
        "learner"
      ]
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 1
    },
    "clientMutationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "sourceDeviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "changes": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "operation": {
              "const": "family.label.update"
            },
            "resourceType": {
              "const": "family"
            },
            "changes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "familyLabel"
              ],
              "properties": {
                "familyLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "learner.profile.update"
            },
            "resourceType": {
              "const": "learner"
            },
            "changes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "displayName"
              ],
              "properties": {
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "learner.placement.update"
            },
            "resourceType": {
              "const": "learner"
            },
            "changes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "grade"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "preschool",
                    "kindergarten",
                    "elementary",
                    "middle",
                    "high",
                    "higher"
                  ]
                },
                "grade": {
                  "enum": [
                    "pre-k",
                    "k",
                    "01",
                    "02",
                    "03",
                    "04",
                    "05",
                    "06",
                    "07",
                    "08",
                    "09",
                    "10",
                    "11",
                    "12",
                    null
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "operation": {
              "const": "learner.continuity.update"
            },
            "resourceType": {
              "const": "learner"
            },
            "changes": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "activePathway": {
                  "type": "string",
                  "maxLength": 120
                },
                "continuityNote": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          }
        }
      ]
    }
  ]
}
