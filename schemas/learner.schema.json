{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://account-cloud/v2/learner.schema.json",
  "title": "Khaemenes Learner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "learnerId",
    "familyId",
    "institutionalId",
    "stage",
    "grade",
    "activePathway",
    "recordVersion",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^learner_"
    },
    "familyId": {
      "type": "string",
      "pattern": "^fam_"
    },
    "accountSubjectRef": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200,
      "description": "Opaque protected student-account authority reference. Not a credential."
    },
    "institutionalId": {
      "type": "string",
      "pattern": "^(KA|KS)-\\d{4}-(?:[A-F0-9]{10}|[A-F0-9]{20})$"
    },
    "institutionalIdStatus": {
      "enum": [
        "provisional",
        "confirmed",
        "migrated"
      ]
    },
    "displayName": {
      "type": "string",
      "maxLength": 120
    },
    "stage": {
      "enum": [
        "preschool",
        "kindergarten",
        "elementary",
        "middle",
        "high",
        "higher"
      ]
    },
    "grade": {
      "enum": [
        "pre-k",
        "k",
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09",
        "10",
        "11",
        "12",
        null
      ]
    },
    "activePathway": {
      "type": "string",
      "maxLength": 120
    },
    "continuityNote": {
      "type": "string",
      "maxLength": 500
    },
    "recordVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
